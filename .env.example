# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Bot ───────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# At least one allowed user or role is required. Comma-separated Discord IDs.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=
# Optional channel restriction (empty permits any channel in the guild).
ALLOWED_CHANNEL_IDS=
# Restrict mentions to these exact channel IDs. Empty = any allowed channel.
MENTION_CHANNEL_IDS=

# Modal-hosted OpenAI-compatible endpoint. MODAL_BASE_URL can be the full
# .../v1/chat/completions URL from the Modal dashboard or just the .../v1
# prefix — the trailing /chat/completions is stripped automatically.
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_MODEL=
# Optional. Passed through to the endpoint as-is; omitted if unset. Higher
# effort raises latency — a synchronous Discord reply is waiting on it.
MODAL_REASONING_EFFORT=
# Optional. Ceiling on tool calls per request (default 40) and max tokens per
# completion (default 8192). There is no other timeout around the agent loop,
# so this is the only backstop against a confused model looping forever —
# real cost on both the model endpoint and any destructive tool it calls.
MAX_TOOL_CALLS=
MODEL_MAX_TOKENS=
TEAM_TIMEZONE=America/Los_Angeles

# Composio API key (shared by bot and dashboard)
COMPOSIO_API_KEY=

# Docker UID/GID — use `id -u` / `id -g` on Linux/Pi; keep defaults on Windows.
DOBBY_UID=10001
DOBBY_GID=10001

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Random 32+ byte hex secret for signing session cookies.
SECRET_KEY=

# Google OAuth app (restrict to uw.edu hosted domain in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth app (add callback: DASHBOARD_URL/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the dashboard/frontend (used for OAuth redirect URIs).
DASHBOARD_URL=http://localhost:3000
# true = running on your own machine: redirects use http://localhost:3000 and
# DASHBOARD_URL is ignored, so a server's URL can stay above untouched.
LOCAL_MODE=false

# UW email of the first admin — seeded into users table on dashboard startup.
BOOTSTRAP_ADMIN_EMAIL=
