DISCORD_TOKEN=
DISCORD_GUILD_ID=
# At least one allowed user or role is required. Comma-separated Discord IDs.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=
# Optional channel restriction (empty permits any channel in the configured guild).
ALLOWED_CHANNEL_IDS=
# Restrict mentions/history to these exact text channel IDs. Empty allows any channel
# Dobby can see in the server (still subject to ALLOWED_CHANNEL_IDS and the allowlists).
MENTION_CHANNEL_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GOOGLE_TOKEN_FILE=secrets/google-token.json
GOOGLE_CALENDAR_ID=primary
TEAM_TIMEZONE=America/Denver
# Docker: Windows can keep these defaults. On Pi/Linux use `id -u` and `id -g`.
DOBBY_UID=10001
DOBBY_GID=10001
# Optional prebuilt image and automatic Pi updates. Use lowercase owner/repository.
DOBBY_IMAGE=
